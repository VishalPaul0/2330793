const AUTH_TOKEN = "your_bearer_token_from_step_2";

const LOG_API = "http://4.224.186.213/evaluation-service/logs";

type Stack = "backend" | "frontend";
type Level = "debug" | "info" | "warn" | "error" | "fatal";

type PackageBackend = "cache" | "controller" | "cron_job" | "db" | "domain" | "handler" | "repository" | "route" | "service";
type PackageFrontend = "api" | "component" | "hook" | "page" | "state";
type PackageCommon = "auth" | "config" | "middleware" | "utils";

type Package = PackageBackend | PackageFrontend | PackageCommon;

export async function Log(
  stack: Stack,
   level: Level,
   pkg: Package,
  message: string
): Promise<void> {
  try {
      await fetch(LOG_API, {
         method: "POST",
     headers: {
        "Content-Type": "application/json",
     "Authorization": `Bearer ${AUTH_TOKEN}`
      },
      body: JSON.stringify({ stack, level, package: pkg, message })
    });

  } catch (err) {
   
 
}
}
